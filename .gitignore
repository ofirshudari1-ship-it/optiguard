# Build output (regenerated by build.ps1 / dotnet build)
# Covers both the app (src/) and the installer (Setup.csproj, root-level) -
# both produce their own bin/ and obj/ at their respective project roots.
bin/
obj/
src/bin/
src/obj/

# User data never belongs in the repo (it lives in %APPDATA%\UninstallerPro on
# the end user's machine, never inside the project folder)
*.user

# Visual Studio local state
.vs/

# Stray compiled binary from the pre-.csproj era (the app used to be built
# directly with csc.exe straight into src/, before OptiGuard.csproj existed).
# Build output belongs in src/bin/, never in src/ itself.
src/OptiGuard.exe

# The built installer is a release asset (attached to GitHub Releases),
# not source - never commit it. build.ps1 regenerates it from source.
OptiGuard-Setup-*.exe
Setup-OptiGuard.exe
